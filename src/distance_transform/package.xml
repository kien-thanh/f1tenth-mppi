<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>distance_transform</name>
  <version>0.0.0</version>
  <description>Converts the global reference path into distance and heading grids that the MPPI cost function samples on the GPU.</description>
  <maintainer email="kien-thanh.tran@outlook.com">Kien-Thanh Tran</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
