<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>path_augment</name>
  <version>0.0.0</version>
  <description>Converts a nav2 path into a vehicle-state trajectory (position, heading, speed, steering).</description>
  <maintainer email="kien-thanh.tran@outlook.com">Kien-Thanh Tran</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>vehicle_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
