{
  "name": "F1TENTH Dev Container",
  "dockerFile": "Dockerfile",
  "runArgs": [
    "--network=f1tenth",
    "-p", "8765:8765",
    "--gpus", "all",
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "0"
  },
  "onCreateCommand": "rosdep init && rosdep update --rosdistro=humble && rosdep install --from-paths src --ignore-src -r -y && colcon build --symlink-install --cmake-args -GNinja -DCMAKE_CUDA_ARCHITECTURES=87",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "Ranch-Hand-Robotics.rde-ros-2",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "tomoki1207.pdf",
        "mechatroner.rainbow-csv"
      ]
    }
  }
}
